{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Intelligent Git Log",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}"
      ],
      "outFiles": [
        "${workspaceFolder}/packages/extension/dist/**/*.js"
      ]
    }
  ]
}
