{
  "name": "vscode-intellij-git-explorer",
  "displayName": "IntelliJ Git Log",
  "description": "MVP VS Code extension that recreates the IntelliJ IDEA Git Log.",
  "version": "0.0.1",
  "publisher": "local",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@10.10.0",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:intellijGitLog.open"
  ],
  "extensionDependencies": [
    "vscode.git"
  ],
  "main": "./packages/extension/dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "intellijGitLog.open",
        "title": "Open IntelliJ Git Log"
      }
    ]
  },
  "scripts": {
    "build": "pnpm run build:contracts && pnpm run build:extension && pnpm run build:webview",
    "build:contracts": "pnpm --filter @intellij-git-log/contracts build",
    "build:extension": "pnpm --filter @intellij-git-log/extension build",
    "build:webview": "pnpm --filter @intellij-git-log/webview build",
    "watch": "pnpm --filter @intellij-git-log/extension build --watch"
  },
  "dependencies": {
    "@intellij-git-log/contracts": "workspace:*",
    "@vscode/codicons": "^0.0.36"
  }
}
