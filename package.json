{
  "name": "vscode-intelligent-git-explorer",
  "displayName": "Intelligent Git Log",
  "description": "MVP VS Code extension that recreates the Intelligent Git Log.",
  "version": "0.0.1",
  "publisher": "local",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@10.10.0",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
  ],
  "extensionDependencies": [
    "vscode.git"
  ],
  "main": "./packages/extension/dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "intelligentGitLog.open",
        "title": "Open Intelligent Git Log"
      }
    ]
  },
  "scripts": {
    "build": "pnpm run build:contracts && pnpm run build:extension && pnpm run build:webview",
    "build:contracts": "pnpm --filter @intelligent-git-log/contracts build",
    "build:extension": "pnpm --filter @intelligent-git-log/extension build",
    "build:webview": "pnpm --filter @intelligent-git-log/webview build",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "pnpm run build && node --test packages/contracts/test/*.test.mjs packages/extension/test/*.test.mjs",
    "watch": "pnpm --filter @intelligent-git-log/extension build --watch"
  },
  "dependencies": {
    "@intelligent-git-log/contracts": "workspace:*",
    "@vscode/codicons": "^0.0.36"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "typescript-eslint": "^8.59.2"
  }
}
