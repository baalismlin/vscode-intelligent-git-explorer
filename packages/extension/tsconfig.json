{
  "compilerOptions": {
    "module": "NodeNext",
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "outDir": "dist",
    "rootDir": "src",
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "moduleResolution": "NodeNext",
    "types": ["node", "vscode"],
    "baseUrl": ".",
    "paths": {
      "#application/*": ["src/application/*"],
      "#domain/*": ["src/domain/*"],
      "#extension/*": ["src/extension/*"],
      "#infrastructure/*": ["src/infrastructure/*"]
    },
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"]
}
