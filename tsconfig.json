{
  "compilerOptions": {
    "module": "nodenext",
    "target": "ES2020",
    "lib": [
      "ES2020",
      "DOM"
    ],
    "outDir": "dist",
    "rootDir": "src",
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "moduleResolution": "nodenext",
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.ts"
  ]
}
